{
  "manifest_version": 2,
  "name": "ToneCraft",
  "version": "1.0.0",
  "description": "AI-powered tone suggestion for Thunderbird emails",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "compose",
    "compose.send",
    "storage",
    "notifications",
    "accountsRead"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tonecraft@extension.thunderbird.org",
      "strict_min_version": "146.0"
    },
    "thunderbird": {
      "id": "tonecraft@extension.thunderbird.org",
      "strict_min_version": "146"
    }
  }
}
